---
layout: default
---
<div class="post content-page section-{{ page.section_key }}" id="main-content">
  <header class="post-header"><h1 class="post-title">{{ page.title | escape }}</h1>{% if page.description %}<p class="post-description">{{ page.description | escape }}</p>{% endif %}</header>
  <article class="article-content">{{ content }}</article>
</div>
