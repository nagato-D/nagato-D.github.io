{% assign locale = page.lang | default: 'en' %}
{% if locale == 'zh-cn' %}{% assign site_description = 'Di Yu 的个人主页：科研进展、学术论文、光电子学与计算机科学笔记。' %}{% else %}{% assign site_description = site.description %}{% endif %}
{% capture page_title %}{% unless page.translation_key == 'home' %}{{ page.title }} | {% endunless %}Di Yu{% endcapture %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | strip | escape }}</title>
<meta name="author" content="Di Yu">
<meta name="description" content="{{ page.description | default: site_description | strip_html | escape }}">
<meta name="generator" content="Jekyll {{ jekyll.version }} · al-folio 1.0.15">
<meta property="og:site_name" content="Di Yu">
<meta property="og:title" content="{{ page_title | strip | escape }}">
<meta property="og:description" content="{{ page.description | default: site_description | strip_html | escape }}">
<meta property="og:type" content="{% if page.layout == 'note' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ page.url | absolute_url }}">
<meta property="og:locale" content="{% if locale == 'zh-cn' %}zh_CN{% else %}en_US{% endif %}">
<meta name="twitter:card" content="summary">
{% if page.translation_url %}
  {% if locale == 'zh-cn' %}{% assign en_url = page.translation_url %}{% assign zh_url = page.url %}{% else %}{% assign en_url = page.url %}{% assign zh_url = page.translation_url %}{% endif %}
  <link rel="alternate" hreflang="en" href="{{ en_url | absolute_url }}">
  <link rel="alternate" hreflang="zh-CN" href="{{ zh_url | absolute_url }}">
  <link rel="alternate" hreflang="x-default" href="{{ en_url | absolute_url }}">
{% endif %}
